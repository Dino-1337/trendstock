REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# LLM tagging backend (optional). Lives in the REPO ROOT .env in this project
# (not backend/.env) - app/tagging/llm_groq.py resolves it by explicit path.
# Without it, tagging runs on the deterministic rule-based tagger only - no
# key is required for the pipeline or API to work.
GROQ_API_KEY=
