# All keys below live in the REPO ROOT .env in this project (not backend/.env).
# app/config.py resolves both by explicit path, repo root first.

# LLM tagging + event reasoning (optional). Without it, tagging runs on the
# deterministic rule-based tagger only - no key is required for the pipeline
# or API to work.
GROQ_API_KEY=

# Exa search, used by the Phase 2 event-refresh research pass.
# Free tier: 20,000 requests/month. Responses are cached for 7 days.
EXA_API_KEY=

# Calendarific, used to resolve festival dates instead of trusting model
# recall (Diwali/Eid/Navratri are lunar and shift every year).
# Free tier: 500 requests/month - one call returns a whole country-year, and
# responses are cached for 30 days, so real usage is a handful of calls.
CALENDARIFIC_API_KEY=
